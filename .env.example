# Supabase Postgres connection strings (Project Settings -> Database -> Connection string in Supabase).
# DATABASE_URL: the pooled "Transaction" connection (port 6543) — used at runtime by the app.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: the session pooler connection (port 5432, same host as above) — used only for migrations (prisma migrate).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project API settings (Project Settings -> API). Safe to expose client-side — this is
# the anon/public key, not the service_role secret.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of email addresses allowed to sign in to /admin. Must match accounts you
# create manually in Supabase Dashboard -> Authentication -> Users (no public admin signup exists).
ADMIN_EMAILS="admin@example.com"
